<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  爱回收驾驶舱 · 本地提醒型定时任务示例（launchd，未启用）

  定位：本地脚本无法复用 Muse 浏览器的登录会话，因此本任务只做
  “到点提醒 + 运行抓取骨架检查”，真正的后台导出仍需用户本人在
  已登录的浏览器中完成。本文件不含任何账号密码。

  安装位置：~/Library/LaunchAgents/com.aihuishou.cockpit.plist
  启用命令：
    cp com.aihuishou.cockpit.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.aihuishou.cockpit.plist
  停用命令：
    launchctl unload ~/Library/LaunchAgents/com.aihuishou.cockpit.plist

  使用前必须改：命令中的 GOAL 改成本机项目根目录的绝对路径。
  时区：StartCalendarInterval 按本机系统时区解释，本机应为 Asia/Shanghai。
  计划：每月 3 日 10:00 运行一次，自动取上个月（date -v-1m 为 macOS 语法）。
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.aihuishou.cockpit</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>-c</string>
		<string>/usr/bin/python3 GOAL/muse_v3/auto_fetch/auto_fetch.py --month "$(date -v-1m +%Y-%m)"</string>
	</array>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Day</key>
		<integer>3</integer>
		<key>Hour</key>
		<integer>10</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>
	<key>StandardOutPath</key>
	<string>GOAL/muse_v3/auto_fetch/status/launchd.out.log</string>
	<key>StandardErrorPath</key>
	<string>GOAL/muse_v3/auto_fetch/status/launchd.err.log</string>
	<key>RunAtLoad</key>
	<false/>
</dict>
</plist>
